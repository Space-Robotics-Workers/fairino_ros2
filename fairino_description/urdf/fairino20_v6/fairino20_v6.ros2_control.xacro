<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was artisanally crafted by Jacob Beck (jbeck@spaceroboticsworkers.com) -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="fairino20_v6_ros2_control" params="prefix mode">
    <ros2_control name="${prefix}fairino20_v6_system" type="system">
      <!-- Load appropriate hardware plugin -->
      <hardware>
        <xacro:if value="${mode == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>

        <xacro:if value="${mode == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>

        <xacro:if value="${mode == 'real'}">
          <plugin>fairino_hardware/FairinoHardwareInterface</plugin>
        </xacro:if>
      </hardware>

      <!-- Configure joint interfaces -->
      <joint name="${prefix}j1">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="${prefix}j2">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="${prefix}j3">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="${prefix}j4">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="${prefix}j5">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>

      <joint name="${prefix}j6">
        <command_interface name="position" />
        <state_interface name="position" />
      </joint>
    </ros2_control>
  </xacro:macro>
</robot>
