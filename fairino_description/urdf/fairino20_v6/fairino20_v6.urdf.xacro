<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was artisanally crafted by Jacob Beck (jbeck@spaceroboticsworkers.com) -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="fairino20_v6_robot">
  <!-- Declare arguments -->
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="parent" default="world" />
  <xacro:arg name="xyz" default="0 0 0" />
  <xacro:arg name="rpy" default="0 0 0" />
  <xacro:arg name="mode" default="mock" />
  <xacro:arg name="control_yaml"
    default="$(find fairino20_v6_moveit2_config)/config/ros2_controllers.yaml" />

  <!-- Include required macros -->
  <xacro:include filename="$(find fairino_description)/urdf/fairino20_v6/fairino20_v6.control.xacro" />
  <xacro:include
    filename="$(find fairino_description)/urdf/fairino20_v6/fairino20_v6.description.xacro" />
  <xacro:include filename="$(find fairino_description)/urdf/fairino20_v6/fairino20_v6.gazebo.xacro" />

  <!-- Build robot -->
  <link name="world" />

  <xacro:fairino20_v6_description prefix="$(arg prefix)" parent="$(arg parent)">
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)" />
  </xacro:fairino20_v6_description>

  <xacro:fairino20_v6_control prefix="$(arg prefix)" mode="$(arg mode)" />

  <xacro:property name="mode" value="$(arg mode)" /> <!-- Get arg as property for evaluation -->
  <xacro:if value="${mode == 'gazebo'}">
    <xacro:fairino20_v6_gazebo namespace="$(arg namespace)" control_yaml="$(arg control_yaml)" />
  </xacro:if>
</robot>
