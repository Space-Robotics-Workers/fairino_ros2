<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was artisanally crafted by Jacob Beck (jbeck@spaceroboticsworkers.com) -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="fairino10_v6_description" params="prefix parent *origin">
    <!-- Include definitions -->
    <xacro:include filename="$(find fairino_description)/urdf/common/materials.xacro" />

    <!-- Connection to parent -->
    <joint name="${prefix}base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${prefix}base_link" />
    </joint>

    <!-- Robot geometry definition -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="-0.00037778 -0.00035367 0.035825" rpy="0 0 0" />
        <mass value="0.73775" />
        <inertia ixx="0.0026263" ixy="1.1085E-05" ixz="-8.5601E-06" iyy="0.0026258"
          iyz="-7.9868E-06" izz="0.0044466" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/base_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/base_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j1" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}base_link" />
      <child link="${prefix}shoulder_link" />
      <axis xyz="0 0 1" />
      <limit lower="-3.0543" upper="3.0543" effort="150" velocity="3.15" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="3.0543261" soft_lower_limit="-3.0543261"
        k_position="100.0" k_velocity="40.0" />
    </joint>

    <link name="${prefix}shoulder_link">
      <inertial>
        <origin xyz="-0.0001 -0.02612 0.18" rpy="0 0 0" />
        <mass value="11.97" />
        <inertia ixx="0.04607471" ixy="-0.00001041" ixz="-0.00009371" iyy="0.03493881"
          iyz="0.00133107" izz="0.04467851" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/shoulder_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/shoulder_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j2" type="revolute">
      <origin xyz="0 0 0.18" rpy="${pi / 2} 0 0" />
      <parent link="${prefix}shoulder_link" />
      <child link="${prefix}upperarm_link" />
      <axis xyz="0 0 1" />
      <limit lower="-4.6251" upper="1.4835" effort="150" velocity="3.15" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="1.4835" soft_lower_limit="-4.6251" k_position="100.0"
        k_velocity="40.0" />
    </joint>

    <link name="${prefix}upperarm_link">
      <inertial>
        <origin xyz="-0.48027 0.00001 0.16468" rpy="0 0 0" />
        <mass value="19.59" />
        <inertia ixx="0.0649166" ixy="0.00054242" ixz="-0.02821532" iyy="1.81964752"
          iyz="-0.00005779" izz="1.80524518" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/upperarm_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/upperarm_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j3" type="revolute">
      <origin xyz="-0.7 0 0" rpy="0 0 0" />
      <parent link="${prefix}upperarm_link" />
      <child link="${prefix}forearm_link" />
      <axis xyz="0 0 1" />
      <limit lower="-2.8274" upper="2.8274" effort="150" velocity="3.15" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="3.0543261" soft_lower_limit="-3.0543261"
        k_position="100.0" k_velocity="40.0" />
    </joint>

    <link name="${prefix}forearm_link">
      <inertial>
        <origin xyz="-0.21122 0.00011 0.05421" rpy="0 0 0" />
        <mass value="3.7" />
        <inertia ixx="0.00642901" ixy="0.00004731" ixz="0.00070041" iyy="0.20273064"
          iyz="0.00000774" izz="0.20206759" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/forearm_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/forearm_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j4" type="revolute">
      <origin xyz="-0.586 0 0" rpy="0 0 0" />
      <parent link="${prefix}forearm_link" />
      <child link="${prefix}wrist1_link" />
      <axis xyz="0 0 1" />
      <limit lower="-4.6251" upper="1.4835" effort="28" velocity="3.2" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="3.0543261" soft_lower_limit="-3.0543261"
        k_position="100.0" k_velocity="40.0" />
    </joint>

    <link name="${prefix}wrist1_link">
      <inertial>
        <origin xyz="0.00012 -0.003 0.159" rpy="0 0 0" />
        <mass value="1.69" />
        <inertia ixx="0.00248058" ixy="0.00001495" ixz="0.00002165" iyy="0.00239729"
          iyz="-0.00007228" izz="0.00180628" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/wrist1_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/wrist1_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j5" type="revolute">
      <origin xyz="0 0 0.159" rpy="${pi / 2} 0 0" />
      <parent link="${prefix}wrist1_link" />
      <child link="${prefix}wrist2_link" />
      <axis xyz="0 0 1" />
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="3.0543261" soft_lower_limit="-3.0543261"
        k_position="100.0" k_velocity="40.0" />
    </joint>

    <link name="${prefix}wrist2_link">
      <inertial>
        <origin xyz="-0.00012 0.003 0.114" rpy="0 0 0" />
        <mass value="1.69" />
        <inertia ixx="0.00248058" ixy="0.00001495" ixz="-0.00002165" iyy="0.00239729"
          iyz="0.00007228" izz="0.00180628" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/wrist2_link.stl" />
        </geometry>
        <material name="white" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/wrist2_link_collision.stl" />
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}j6" type="revolute">
      <origin xyz="0 0 0.114" rpy="${-pi / 2} 0 0" />
      <parent link="${prefix}wrist2_link" />
      <child link="${prefix}wrist3_link" />
      <axis xyz="0 0 1" />
      <limit lower="-3.0543" upper="3.0543" effort="28" velocity="3.2" />
      <calibration rising="0" falling="0" />
      <dynamics damping="0" friction="0" />
      <safety_controller soft_upper_limit="3.0543261" soft_lower_limit="-3.0543261"
        k_position="100.0" k_velocity="40.0" />
    </joint>

    <link name="${prefix}wrist3_link">
      <inertial>
        <origin xyz="0.00124 0.00085 0.084" rpy="0 0 0" />
        <mass value="0.35" />
        <inertia ixx="0.00023661" ixy="-0.00000085" ixz="0.00000092" iyy="0.00023501"
          iyz="-0.00000154" izz="0.00036972" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/visual/wrist3_link.stl" />
        </geometry>
        <material name="silver" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fairino_description/meshes/fairino10_v6/collision/wrist3_link_collision.stl" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
