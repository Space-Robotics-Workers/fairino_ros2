<?xml version="1.0" encoding="utf-8"?>
<!-- This URDF was artisanally crafted by Jacob Beck (jbeck@spaceroboticsworkers.com) -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="fairino10_v6_gazebo" params="namespace control_yaml">
    <!-- Load system plugin -->
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${control_yaml}</parameters>
        <ros>
          <namespace>${namespace}</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
